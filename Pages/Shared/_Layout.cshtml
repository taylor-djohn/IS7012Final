<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>&#127916; @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IS7012Final.styles.css" asp-append-version="true" />
    <style>
            body {
                background-color: #171616;
            }

            h1, h2, h3, h4, h5, p, th, td {
                color: #ffffff;
                font-family: "Courier New", Courier, monospace;
            }
            
            hr {
                border-top: 1px solid #ffffff;
            }

            .navbar-brand, .nav-link {
                color: #171616;
                font-weight: 800;
                font-family: "Courier New", Courier, monospace;
            }

                .navbar-brand:hover, .nav-link:hover {
                    opacity: 0.8;
                }

            footer {
                background-color: #171616;
                color: #ffffff;
                padding: 12px 0;
                margin-top: 40px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">&#127916; Movie Social</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/MoviePages/Popular">Popular</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/GenrePages/GenreList">Genres</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/WatchlistPages/Index">Watchlist</a>
</li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - IS7012Final - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>