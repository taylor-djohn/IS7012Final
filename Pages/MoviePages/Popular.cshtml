@page
@model IS7012Final.Pages.MoviePages.PopularModel

@{
    ViewData["Title"] = "Popular Movies";
}

<style>
    .popular-container {
        background-color: #141414;
        color: white;
        padding: 30px;
        border-radius: 12px;
        min-height: 75vh;
    }

    .movie-card {
        background-color: #222;
        border: 1px solid #333;
        border-radius: 10px;
        overflow: hidden;
        height: 100%;
        transition: transform 0.2s;
    }

        .movie-card:hover {
            transform: scale(1.03);
        }

    .movie-poster {
        width: 100%;
        height: 320px;
        object-fit: cover;

    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        color: white;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .movie-genre {
        color: #aaa;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .movie-date {
        color: #aaa;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .movie-rating {
        color: #ffc107;
        font-size: 16px;
        margin-bottom: 10px;
    }

    .movie-overview {
        color: #ccc;
        font-size: 14px;
        line-height: 1.5;
    }

    .section-title {
        color: white;
        margin-bottom: 25px;
        text-align: center;
    }
</style>

<div class="popular-container">

    <h1 class="section-title">🎬 Popular Movies</h1>

    @if (Model.Movie != null && Model.Movie.Any())
    {
        <div class="row">

            @foreach (var movie in Model.Movie)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                    <div class="movie-card">

                        @if (!string.IsNullOrEmpty(movie.Poster))
                        {
                            <img src="@movie.Poster"
                                 class="movie-poster"
                                 alt="@movie.Title"
                                 onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                        }
                        else
                        {
                            <div class="movie-poster d-flex align-items-center justify-content-center bg-secondary">
                                No Poster Available
                            </div>
                        }

                        <div class="movie-info">

                            <div class="movie-title">
                                @movie.Title
                            </div>

                            <div class="movie-genre">
                                @string.Join(", ", movie.Genres ?? new List<string>())
                            </div>

                            <div class="movie-date">
                                Released: @movie.Release_Date
                            </div>

                            <div class="movie-rating">
                                ⭐ @movie.Rating.ToString("0.0") / 5
                            </div>

                            <div class="movie-overview">
                                @movie.Overview
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            No popular movies available.
        </div>
    }

</div>
