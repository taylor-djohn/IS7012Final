@page
@model IndexModel
@using IS7012Final.Model
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Movie Social";
    var appUser = await UserManager.GetUserAsync(User);
}

<style>
    h1, h2, h3, h4, h5, p, th, td {
        color: #ffffff;
        font-family: "Courier New", Courier, monospace;
    }

    hr {
        border-top: 1px solid #ffffff;
    }

    .text-center {
        text-align: center;
    }

    /* Movie Grid */
    .movie-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 20px 0;
    }

    /* Trending and Top Rated Movie Cards */
    .movie-card {
        border: 1px solid #ccc;
        padding: 10px;
        margin: 10px;
        width: 350px;
        color: #171616;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .movie-card h2,
        .movie-card p {
            color: #ffffff;
        }

    .poster {
        width: 100%;
        height: auto;
        border-radius: 6px;
        object-fit: cover;
    }

    /* Recent Activity Cards */
    .feed-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 15px;
        background-color: #f8f9fa;
        color: #171616;
        margin-bottom: 15px;
        text-align: left;
    }

        .feed-card p {
            color: #171616;
        }

    .feed-comment {
        color: #171616;
        font-style: italic;
        margin-top: 6px;
        margin-bottom: 6px;
    }
    .card-link {
        text-decoration: none;
        color: inherit;
    }
    .movie-title-link {
        color: #171616;
        text-decoration: underline;
    }
</style>

<h1 class="text-center">&#127916; MOVIE SOCIAL</h1>
<p class="text-center">
    Welcome back @((appUser?.FirstName != null) ? appUser.FirstName : User.Identity?.Name)! Discover what people are watching.
</p>

<hr />

<!-- 🔥 Trending Movies Section -->
<h3 class="text-center">🔥 Trending Movies</h3>
<div class="movie-grid">
    @{
        var trendingList = Model.TrendingMovies;
        var tIndex = 0;
        if (trendingList != null && trendingList.Any())
        {
            while (tIndex < trendingList.Count)
            {
                var movie = trendingList[tIndex];
                <div class="movie-card">
                <a asp-page="/ReviewPages/Details" asp-route-movieId="@movie.Id" class="card-link">
                    <img src="@movie.Poster" class="poster" alt="@movie.Title poster" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                    <h2>@movie.Title</h2>
                    </a>
                    <p>⭐ @movie.Rating</p>
                </div>
                tIndex++;
            }
        }
        else
        {
            <p>No trending movies available.</p>
        }
    }
</div>

<hr />

<!-- 📰 Recent Activity Section -->
<h3 class="text-center">📰 Recent Activity</h3>
<div class="row justify-content-center">
    <div class="col-md-8">
        @{
            var activityList = Model.RecentActivity;
            var fIndex = 0;
            if (activityList != null && activityList.Any())
            {
                while (fIndex < activityList.Count)
                {
                    var activity = activityList[fIndex];
                    <div class="feed-card">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@activity.UserName</strong> reviewed <strong>@activity.MovieTitle</strong>
                                <span class="badge bg-secondary ms-2">@activity.UserReviewCount reviews</span>
                            </div>
                            <small class="text-muted">@activity.Timestamp.ToShortDateString()</small>
                        </div>
                        <div class="my-1">
                            @{
                                var r = 0;
                                while (r < activity.Rating)
                                {
                                    <span>⭐</span>
                                    r++;
                                }
                            }
                        </div>
                        <p class="feed-comment">"@activity.Comment"</p>
                    </div>
                    fIndex++;
                }
            }
            else
            {
                <p class="text-center text-muted">No recent activity found in database.</p>
            }
        }
    </div>
</div>

<hr />

<!-- ⭐ Top Rated Movies Section -->
<h3 class="text-center">⭐ Top Rated Movies</h3>
<div class="movie-grid">
    @{
        var topList = Model.TopRatedMovies;
        var trIndex = 0;
        if (topList != null && topList.Any())
        {
            while (trIndex < topList.Count)
            {
                var movie = topList[trIndex];
                <div class="movie-card">
                <a asp-page="/ReviewPages/Details" asp-route-movieId="@movie.Id" class="card-link">
                    <img src="@movie.Poster" class="poster" alt="@movie.Title poster" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                    <h2>@movie.Title</h2>
                </a>
                    <p>⭐ @movie.Rating</p>
                </div>
                trIndex++;
            }
        }
        else
        {
            <p>No top-rated movies available.</p>
        }
    }
</div>