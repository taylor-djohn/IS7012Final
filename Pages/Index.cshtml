@page
@model IndexModel
@using IS7012Final.Model
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Movie Social";
    // 1. Fake Trending Movies Data
    var trendingMovies = new List<dynamic>
    {
        new { Title = "Avatar", Poster = "https://image.tmdb.org/t/p/w500/6EiRUJpuoeQPghrs3YNktfnqOVh.jpg", Rating = 7.2, Genre = "Action" },
        new { Title = "Jurassic World", Poster = "https://image.tmdb.org/t/p/w500/rAiYTfKGqDfqI28mR4jWwX1a9M.jpg", Rating = 6.6, Genre = "Adventure" },
        new { Title = "Interstellar", Poster = "https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg", Rating = 8.6, Genre = "Sci-Fi" }
    };

    // 2. Fake Top Rated Movies Data
    var topRatedMovies = new List<dynamic>
    {
        new { Title = "The Dark Knight", Poster = "https://image.tmdb.org/t/p/w500/qJ2tW6WMUDux911r6m7haRef0WH.jpg", Rating = 8.5, Genre = "Action" },
        new { Title = "Forrest Gump", Poster = "https://image.tmdb.org/t/p/w500/saHP97rTPS5eLmrLQEcANmKrsFl.jpg", Rating = 8.5, Genre = "Drama" },
        new { Title = "The Lord of the Rings", Poster = "https://image.tmdb.org/t/p/w500/rCzpDGLbOoPwLjy3OAm5NUPOTrC.jpg", Rating = 8.4, Genre = "Fantasy" }
    };

    // 3. Fake Feed & Popular Reviews Data
    var recentActivity = new List<dynamic>
    {
        new { User = "Hayden", Action = "reviewed", Movie = "Interstellar", Rating = 5, Comment = "Amazing movie... mind-blowing visuals!", Likes = 12 },
        new { User = "Alex", Action = "liked a review for", Movie = "The Dark Knight", Rating = 5, Comment = "Best superhero movie ever made.", Likes = 34 },
        new { User = "Jordan", Action = "reviewed", Movie = "Avatar", Rating = 4, Comment = "Great visual effects, classic story.", Likes = 8 }
    };

    var appUser = await UserManager.GetUserAsync(User);
}

<style>
    .text-center {
        text-align: center;
    }

    .center-image {
        display: block;
        margin-left: auto;
        margin-right: auto;
        border-radius: 8px;
        object-fit: cover;
    }

    .form-row {
        margin-bottom: 12px;
    }

        .form-row label {
            display: inline-block;
            width: 120px;
        }

        .form-row input {
            width: 250px;
        }

    ul {
        text-align: left;
    }

    /* Movie Details & Layout */
    .movie-card-container {
        border: 1px solid #ccc;
        padding: 10px;
        margin: 10px;
        width: 350px;
    }

    .movie-title {
        font-weight: bold;
        font-size: 1.1rem;
        margin-top: 8px;
        margin-bottom: 4px;
    }

    .movie-sub {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    /* Activity Feed Styles */
    .feed-card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 15px;
        background-color: #f8f9fa;
        margin-bottom: 15px;
        text-align: left;
    }

    .feed-comment {
        font-style: italic;
        margin-top: 6px;
        margin-bottom: 6px;
    }
</style>

<h1 class="text-center">&#127916; MOVIE SOCIAL</h1>
<p class="text-center">Welcome back @((appUser?.FirstName != null) ? appUser.FirstName : User.Identity?.Name)! Discover what people are watching.</p>

<!-- 🔥 Trending Movies Section -->
<h3 class="text-center">🔥 Trending Movies</h3>
<div class="row">
    @{
        var tIndex = 0;
        while (tIndex < trendingMovies.Count)
        {
            var movie = trendingMovies[tIndex];
            <div class="col-md-4">
                <div class="movie-card-container text-center">
                    <img src="@movie.Poster" alt="@movie.Title poster" class="center-image" width="290" height="400" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                    <p class="movie-title">@movie.Title</p>
                    <p class="movie-sub">⭐ @movie.Rating | @movie.Genre</p>
                </div>
            </div>
            tIndex++;
        }
    }
</div>

<hr />

<!-- 📰 Recent Activity Section -->
<h3 class="text-center">📰 Recent Activity</h3>
<div class="row justify-content-center">
    <div class="col-md-8">
        @{
            var fIndex = 0;
            while (fIndex < recentActivity.Count)
            {
                var activity = recentActivity[fIndex];
                <div class="feed-card">
                    <div>
                        <strong>@activity.User</strong> @activity.Action <strong>@activity.Movie</strong>
                    </div>
                    <div>
                        @{
                            var r = 0;
                            while (r < activity.Rating)
                            {
                                <span>⭐</span>
                                r++;
                            }
                        }
                    </div>
                    <p class="feed-comment">"@activity.Comment"</p>
                    <small class="text-muted">❤️ @activity.Likes likes</small>
                </div>
                fIndex++;
            }
        }
    </div>
</div>

<hr />

<!-- ⭐ Top Rated Movies Section -->
<h3 class="text-center">⭐ Top Rated Movies</h3>
<div class="row">
    @{
        var trIndex = 0;
        while (trIndex < topRatedMovies.Count)
        {
            var movie = topRatedMovies[trIndex];
            <div class="col-md-4">
                <div class="movie-card-container text-center">
                    <img src="@movie.Poster" alt="@movie.Title poster" class="center-image" width="290" height="400" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                    <p class="movie-title">@movie.Title</p>
                    <p class="movie-sub">⭐ @movie.Rating | @movie.Genre</p>
                </div>
            </div>
            trIndex++;
        }
    }
</div>