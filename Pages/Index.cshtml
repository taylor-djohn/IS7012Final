@page
@model IndexModel
@using IS7012Final.Model
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Movie Social";
    var appUser = await UserManager.GetUserAsync(User);
}

<style>
    .home-container {
        background-color: #141414;
        color: white;
        padding: 30px;
        border-radius: 12px;
        min-height: 75vh;
    }

    .movie-card {
        background-color: #222;
        border: 1px solid #333;
        border-radius: 10px;
        overflow: hidden;
        height: 100%;
        transition: transform 0.2s;
    }

        .movie-card:hover {
            transform: scale(1.03);
        }

    .movie-poster {
        width: 100%;
        height: 320px;
        object-fit: cover;
    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        color: white;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .movie-rating {
        color: #ffc107;
        font-size: 16px;
        margin-bottom: 5px;
    }

    .movie-link {
        text-decoration: none;
        color: inherit;
    }

        .movie-link:hover {
            color: inherit;
        }

    .feed-card {
        background-color: #222;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 15px;
        color: white;
    }

    .feed-comment {
        color: #ccc;
        font-style: italic;
        margin-top: 10px;
    }

    .section-title {
        color: white;
        margin-top: 30px;
        margin-bottom: 20px;
        text-align: center;
    }

    .home-divider {
        border-top: 1px solid #444;
        margin: 35px 0;
    }
</style>

<div class="home-container">

    <h1 class="text-center mb-3">🎬 MOVIE SOCIAL</h1>

    <p class="text-center text-light">
        Welcome back @((appUser?.FirstName != null) ? appUser.FirstName : User.Identity?.Name)!
        Discover what people are watching.
    </p>

    <hr class="home-divider" />

    <!-- Trending Movies -->
    <h3 class="section-title">🔥 Trending Movies</h3>

    <div class="row">
        @if (Model.TrendingMovies != null && Model.TrendingMovies.Any())
        {
            foreach (var movie in Model.TrendingMovies)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="movie-card">

                        <a asp-page="/ReviewPages/Details"
                           asp-route-movieId="@movie.Id"
                           class="movie-link">

                            @if (!string.IsNullOrEmpty(movie.Poster))
                            {
                                <img src="@movie.Poster"
                                     class="movie-poster"
                                     alt="@movie.Title"
                                     onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                            }
                            else
                            {
                                <div class="movie-poster d-flex align-items-center justify-content-center bg-secondary">
                                    No Poster Available
                                </div>
                            }

                            <div class="movie-info">
                                <div class="movie-title">@movie.Title</div>

                                <div class="movie-rating">
                                    ⭐ @movie.Rating.ToString("0.0") / 5
                                </div>
                            </div>

                        </a>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center text-light">No trending movies available.</p>
        }
    </div>

    <hr class="home-divider" />

    <!-- Recent Activity -->
    <h3 class="section-title">📰 Recent Activity</h3>

    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (Model.RecentActivity != null && Model.RecentActivity.Any())
            {
                foreach (var activity in Model.RecentActivity)
                {
                    <div class="feed-card">

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@activity.UserName</strong>
                                reviewed
                                <strong>@activity.MovieTitle</strong>

                                <span class="badge bg-secondary ms-2">
                                    @activity.UserReviewCount reviews
                                </span>
                            </div>

                            <small class="text-light">
                                @activity.Timestamp.ToShortDateString()
                            </small>
                        </div>

                        <div class="mt-2">
                            @for (int i = 0; i < activity.Rating; i++)
                            {
                                <span>⭐</span>
                            }
                        </div>

                        <p class="feed-comment">
                            "@activity.Comment"
                        </p>

                    </div>
                }
            }
            else
            {
                <p class="text-center text-light">
                    No recent activity found.
                </p>
            }

        </div>
    </div>

    <hr class="home-divider" />

    <!-- Top Rated Movies -->
    <h3 class="section-title">⭐ Top Rated Movies</h3>

    <div class="row">
        @if (Model.TopRatedMovies != null && Model.TopRatedMovies.Any())
        {
            foreach (var movie in Model.TopRatedMovies)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="movie-card">

                        <a asp-page="/ReviewPages/Details"
                           asp-route-movieId="@movie.Id"
                           class="movie-link">

                            @if (!string.IsNullOrEmpty(movie.Poster))
                            {
                                <img src="@movie.Poster"
                                     class="movie-poster"
                                     alt="@movie.Title"
                                     onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                            }
                            else
                            {
                                <div class="movie-poster d-flex align-items-center justify-content-center bg-secondary">
                                    No Poster Available
                                </div>
                            }

                            <div class="movie-info">
                                <div class="movie-title">@movie.Title</div>

                                <div class="movie-rating">
                                    ⭐ @movie.Rating.ToString("0.0") / 5
                                </div>
                            </div>

                        </a>

                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center text-light">
                No top-rated movies available.
            </p>
        }
    </div>

</div>
