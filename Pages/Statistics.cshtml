@page
@model IS7012Final.Pages.StatistiscsModel
@{
    ViewData["Title"] = "📊 My Statistics";
}

<style>
    /* General Page Header & Text */
    h1 {
        color: #ffffff;
        font-family: "Courier New", Courier, monospace;
    }

    /* Summary Stat Cards */
    .stat-box {
        border: 1px solid #ffffff;
        border-radius: 8px;
        padding: 20px;
        background-color: #ffffff;
        color: #171616;
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: bold;
        color: #171616;
        margin: 0;
        font-family: "Courier New", Courier, monospace;
    }

    .stat-card-title {
        color: #171616;
        font-family: "Courier New", Courier, monospace;
        font-weight: bold;
    }

    /* Rating Breakdown Card */
    .rating-card {
        background-color: #ffffff;
        border: 1px solid #ccc;
        border-radius: 8px;
        color: #171616;
    }

        .rating-card h3 {
            color: #171616;
            font-family: "Courier New", Courier, monospace;
            font-weight: bold;
        }

    /* Custom Styles for Stars, Counts, and Percentages */
    .star-label {
        color: #f39c12; /* Gold/Star color */
        font-weight: bold;
        font-size: 1.1rem;
        font-family: "Courier New", Courier, monospace;
    }

    .count-label {
        color: #171616;
        font-weight: 700;
        font-family: "Courier New", Courier, monospace;
    }

    .percentage-badge {
        background-color: #171616;
        color: #ffffff;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: "Courier New", Courier, monospace;
    }
</style>

<h1 class="text-center mb-4">📊 MY MOVIE STATISTICS</h1>

<!-- Summary Row -->
<div class="row text-center mb-5">
    <div class="col-md-6 mb-3 mb-md-0">
        <div class="stat-box shadow-sm">
            <h3 class="stat-card-title">Movies Reviewed</h3>
            <p class="stat-number">@Model.TotalReviews</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-box shadow-sm">
            <h3 class="stat-card-title">Average Rating</h3>
            <p class="stat-number">@Model.AverageRating.ToString("0.0") ⭐</p>
        </div>
    </div>
</div>

<!-- Rating Breakdown Row -->
<div class="row justify-content-center">
    <div class="col-md-8 mb-4">
        <div class="card rating-card p-4 shadow-sm">
            <h3>Rating Distribution</h3>
            <hr />
            @{
                var distList = Model.RatingDistribution;
                var distIndex = 0;
                while (distIndex < distList.Count)
                {
                    var item = distList[distIndex];
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <!-- Styled Stars Label -->
                            <span class="star-label">@item.Stars ⭐</span>

                            <!-- Styled Count and Percentage Badge -->
                            <div>
                                <span class="count-label">@item.Count review@(item.Count == 1 ? "" : "s")</span>
                                <span class="percentage-badge ms-1">@item.Percentage%</span>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress" style="height: 18px; background-color: #e9ecef;">
                            <div class="progress-bar bg-warning"
                                 role="progressbar"
                                 style="width: @item.Percentage%;"
                                 aria-valuenow="@item.Percentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                    distIndex++;
                }
            }
        </div>
    </div>
</div>