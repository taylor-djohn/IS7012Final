@page
@model IS7012Final.Pages.WatchlistPages.IndexModel

@{
    ViewData["Title"] = "My Watchlist";
}

<h1>My Watchlist</h1>

<p class="text-muted">
    Movies you've saved to watch later.
</p>

@if (Model.WatchlistItems.Count == 0)
{
    <div class="alert alert-info">
        Your watchlist is empty.
    </div>
}
else
{
    <div class="row">

        @foreach (var item in Model.WatchlistItems)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">

                    <div class="card-body">

                        <h4 class="card-title">
                            @item.Movie?.Title
                        </h4>

                        <p class="card-text">
                            <strong>Director:</strong>
                            @item.Movie?.Director
                        </p>

                        <p class="card-text">
                            <strong>Release Year:</strong>
                            @item.Movie?.ReleaseYear
                        </p>

                        <p class="card-text">
                            <strong>Genre:</strong>
                            @item.Movie?.Genre
                        </p>

                        <p class="text-muted">
                            Added @item.DateAdded.ToString("MM/dd/yyyy")
                        </p>

                        <a asp-page="/MoviePages/Details"
                           asp-route-id="@item.MovieId"
                           class="btn btn-primary">
                            View Movie
                        </a>

                        <form method="post"
                              asp-page-handler="Remove"
                              asp-route-id="@item.Id"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-danger">
                                Remove
                            </button>

                        </form>

                    </div>
                </div>
            </div>
        }

    </div>
}