@page
@model IS7012Final.Pages.WatchlistPages.IndexModel

@{
    ViewData["Title"] = "My Watchlist";
}
<style>
    .watchlist-poster {
        width: 100%;
        height: auto;
        object-fit: cover;
    }
</style>
<h1>My Watchlist</h1>

@if (Model.WatchlistItems == null || Model.WatchlistItems.Count == 0)
{
    <div class="alert alert-info">
        Your watchlist is empty.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model.WatchlistItems)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @{
                        string? poster = null;
                        if (Model.PosterUrls != null) Model.PosterUrls.TryGetValue(item.MovieId, out poster);
                    }
                    @if (!string.IsNullOrEmpty(poster))
                    {
                        <img src="@poster" class="watchlist-poster" alt="@item.Movie?.Title poster" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                    }
                    <div class="card-body">
                        <h4 class="card-title">
                            @item.Movie?.Title
                        </h4>

                        <p class="text-muted">
                            Added @item.DateAdded.ToString("MM/dd/yyyy")
                        </p>


                        <a asp-page="/ReviewPages/Details"
                           asp-route-movieId="@item.MovieId"
                           class="btn btn-primary">
                            View Reviews
                        </a>

                        <form method="post"
                              asp-page-handler="Remove"
                              asp-route-id="@item.Id"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-danger">
                                Remove
                            </button>

                        </form>

                    </div>
                </div>
            </div>
        }
    </div>    
}