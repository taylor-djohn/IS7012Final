@page
@model IS7012Final.Pages.ReviewPages.CreateModel

@{
    ViewData["Title"] = "Create Review";
}

<h1>Create Review</h1>

<h4>Share your thoughts about a movie</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Review.MovieId" class="control-label">Movie</label>

                <select asp-for="Review.MovieId"
                        asp-items="Model.MovieList"
                        class="form-control">
                    <option value="">-- Select a Movie --</option>
                </select>

                <span asp-validation-for="Review.MovieId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Review.Rating" class="control-label"></label>

                <select asp-for="Review.Rating" class="form-control">
                    <option value="">-- Select Rating --</option>
                    <option value="1">1 - Poor</option>
                    <option value="2">2 - Fair</option>
                    <option value="3">3 - Good</option>
                    <option value="4">4 - Very Good</option>
                    <option value="5">5 - Excellent</option>
                </select>

                <span asp-validation-for="Review.Rating"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Review.ReviewText" class="control-label"></label>

                <textarea asp-for="Review.ReviewText"
                          class="form-control"
                          rows="5"
                          placeholder="What did you think of this movie?"></textarea>

                <span asp-validation-for="Review.ReviewText"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Post Review"
                       class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index">Back to Reviews</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}