@page
@model IS7012Final.Pages.ReviewPages.DetailsModel

@{
    ViewData["Title"] = "Review Details";
}

<h1>Details</h1>

<div>
    <h4>@Model.Movie?.Title</h4>
    <hr />

    @if (Model.Review == null)
    {
        <div class="alert alert-info">No review available for this movie.</div>
        <div>
            <a asp-page="./Index">Back to List</a>
        </div>
    }
    else
    {
        <h4>Review</h4>
        <dl class="row">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Review.MovieTitle)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Review.MovieTitle)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Review.Rating)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Review.Rating)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Review.ReviewText)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Review.ReviewText)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Review.Timestamp)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Review.Timestamp)
            </dd>
        </dl>

        <div>
            <a asp-page="./Edit" asp-route-id="@Model.Review.Id">Edit</a> |
            <a asp-page="./Index">Back to List</a>
        </div>
    }

</div>
