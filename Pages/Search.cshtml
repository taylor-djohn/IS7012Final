@page
@model IS7012Final.Pages.SearchModel

@{
    ViewData["Title"] = "Search Movies";
}

<style>
    .search-results {
        margin-top: 30px;
    }

    .search-card {
        background-color: #171616;
        border: 1px solid #ffffff;
        padding: 20px;
        margin-bottom: 25px;
        display: flex;
        gap: 20px;
    }

    .search-poster {
        width: 150px;
        height: auto;
        object-fit: cover;
    }

    .search-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container mt-4">

    <h1>🔍 Search Movies</h1>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input asp-for="SearchTerm"
                   class="form-control"
                   placeholder="Search by movie title..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <h4>Results for "@Model.SearchTerm"</h4>

        <div class="search-results">
            @if (Model.Movies != null && Model.Movies.Any())
            {
                var movieList = Model.Movies.ToList();
                var index = 0;

                while (index < movieList.Count)
                {
                    var movie = movieList[index];

                    <div class="search-card">
                        @if (!string.IsNullOrWhiteSpace(movie.Poster))
                        {
                            <img src="@movie.Poster"
                                 class="search-poster"
                                 alt="@movie.Title poster"
                                 onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                        }

                        <div class="search-info">
                            <div>
                                <h2>@movie.Title</h2>

                                <p>
                                    <strong>Genres:</strong>
                                    @string.Join(", ", movie.Genres ?? new List<string>())
                                </p>

                                <p>
                                    <strong>Release Date:</strong>
                                    @movie.Release_Date
                                </p>

                                <p>
                                    <strong>Rating:</strong>
                                    ⭐ @movie.Rating
                                </p>

                                <p>
                                    @movie.Overview
                                </p>
                            </div>

                            <!-- Action Buttons -->
                            <div class="mt-3 d-flex gap-2 align-items-center">
                                <!-- Button 1: Add to Watchlist -->
                              
                                <form method="post" asp-page-handler="AddToWatchlist" class="m-0">
                                    <input type="hidden" name="movieId" value="@movie.MovieId" />
                                    <button type="submit" class="btn btn-success">
                                        ➕ Add to Watchlist
                                    </button>
                                </form>

                                <!-- Button 2: Link to Review Details Page -->
                                <a asp-page="/ReviewPages/Details"
                                   asp-route-movieId="@movie.MovieId"
                                   class="btn btn-info text-white">
                                    ⭐ View Reviews
                                </a>
                            </div>
                        </div>
                    </div>

                    index++;
                }
            }
            else
            {
                <p>No movies found matching your search.</p>
            }
        </div>
    }
</div>